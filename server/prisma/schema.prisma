generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
  LOCKED
}

enum StudentStatus {
  STUDYING
  RESERVED
  GRADUATED
  DROPPED_OUT
  SUSPENDED
}

enum EmploymentStatus {
  WORKING
  ON_LEAVE
  CONTRACT_ENDED
  RESIGNED
  TERMINATED
}

enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  CANCELLED
}

enum AnnouncementCategory {
  GENERAL
  HOLIDAY
  ACADEMIC
  EVENT
  EMERGENCY
}

enum AnnouncementAudience {
  ALL
  ROLES
  DEPARTMENTS
}

// Static RBAC: roles are part of the application contract, not editable database records.
enum UserRole {
  ADMIN
  PRINCIPAL
  HR
  TRAINING_OFFICER
  DEPARTMENT_HEAD
  LECTURER
  STUDENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  LOGIN
  LOGOUT
  RESET_PASSWORD
  CHANGE_PASSWORD
  APPROVE
  REJECT
  ASSIGN
  ENROLL
  DROP
}

enum EnrollmentStatus {
  ACTIVE
  DROPPED
}

enum LessonType {
  TEXT
  VIDEO
  DOCUMENT
  PDF
  LINK
  CODE
}

enum MediaType {
  IMAGE
  PDF
  DOCUMENT
}

enum AssessmentCategory {
  ASSIGNMENT
  QUIZ
  MIDTERM
  FINAL
}

enum ScorePolicy {
  HIGHEST
  LATEST
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  ESSAY
  CODE
  HTML_CSS
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  PENDING_GRADING
  GRADED
  AUTO_SUBMITTED
}

enum JudgeStatus {
  NOT_REQUIRED
  QUEUED
  PROCESSING
  ACCEPTED
  WRONG_ANSWER
  ERROR
}

enum ViolationType {
  WINDOW_BLUR
  PAGE_HIDDEN
  EXIT_FULLSCREEN
  HEARTBEAT_LOST
}

enum ProposalStatus {
  DRAFT
  PENDING_TRAINING
  PENDING_PRINCIPAL
  APPROVED
  REJECTED
}

enum ClassProposalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ClassStatus {
  DRAFT
  OPEN_REGISTRATION
  CLOSED_REGISTRATION
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SubjectStatus {
  DRAFT
  PUBLIC
  ARCHIVE
}

enum SubjectRestoreRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Department {
  id          Int      @id @default(autoincrement())
  publicId    String   @unique @default(uuid())
  code        String   @unique
  name        String   @unique
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users            User[]
  subjects         Subject[]
  subjectProposals SubjectProposal[]
  classes          Class[]
}

model User {
  id                          Int               @id @default(autoincrement())
  publicId                    String            @unique @default(uuid())
  code                        String            @unique
  fullName                    String
  email                       String            @unique
  phone                       String?           @unique
  password                    String
  role                        UserRole          @default(STUDENT)
  status                      UserStatus        @default(ACTIVE)
  studentStatus               StudentStatus?
  studentStatusChangedAt      DateTime?
  studentStatusChangedById    Int?
  studentStatusChangedBy      User?             @relation("StudentStatusChanger", fields: [studentStatusChangedById], references: [id], onDelete: SetNull)
  studentStatusChanges        User[]            @relation("StudentStatusChanger")
  employmentStatus            EmploymentStatus?
  employmentStatusChangedAt   DateTime?
  employmentEndedAt           DateTime?
  employmentStatusChangedById Int?
  employmentStatusChangedBy   User?             @relation("EmploymentStatusChanger", fields: [employmentStatusChangedById], references: [id], onDelete: SetNull)
  employmentStatusChanges     User[]            @relation("EmploymentStatusChanger")
  gender                      Gender?
  dateOfBirth                 DateTime?
  address                     String?           @db.VarChar(500)
  avatarUrl                   String?           @db.VarChar(500)

  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  resetPasswordOtp          String?
  resetPasswordOtpExpiresAt DateTime?
  activationToken           String?   @unique
  activationTokenExpiresAt  DateTime?
  lastLoginAt               DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  sessions                Session[]
  auditLogs               AuditLog[]              @relation("AuditActor")
  proposedSubjects        SubjectProposal[]       @relation("SubjectProposer")
  trainingSubjectReviews  SubjectProposal[]       @relation("TrainingSubjectReviewer")
  principalSubjectReviews SubjectProposal[]       @relation("PrincipalSubjectReviewer")
  proposedSubjectRestores SubjectRestoreRequest[] @relation("SubjectRestoreRequester")
  reviewedSubjectRestores SubjectRestoreRequest[] @relation("SubjectRestoreReviewer")
  proposedClasses         ClassProposal[]         @relation("ClassProposer")
  classProposalReviews    ClassProposal[]         @relation("ClassProposalReviewer")
  managedClasses          Class[]                 @relation("ClassManager")
  teachingClasses         Class[]                 @relation("ClassLecturer")
  enrollments             Enrollment[]
  notifications           Notification[]
  attempts                AssessmentAttempt[]
  gradedAnswers           AttemptAnswer[]         @relation("AnswerGrader")
  lessonProgress          LessonProgress[]
  mediaUploads            Media[]                 @relation("MediaUploader")
  updatedSystemSettings   SystemSetting[]         @relation("SystemSettingUpdater")
  createdAnnouncements    Announcement[]          @relation("AnnouncementCreator")
  publishedAnnouncements  Announcement[]          @relation("AnnouncementPublisher")

  @@index([role, status])
  @@index([studentStatus])
  @@index([employmentStatus])
  @@index([studentStatusChangedById])
  @@index([employmentStatusChangedById])
  @@index([departmentId])
}

model Subject {
  id               Int           @id @default(autoincrement())
  publicId         String        @unique @default(uuid())
  code             String        @unique
  name             String
  description      String?       @db.Text
  credits          Int
  assignmentWeight Decimal       @default(10) @db.Decimal(5, 2)
  quizWeight       Decimal       @default(20) @db.Decimal(5, 2)
  midtermWeight    Decimal       @default(20) @db.Decimal(5, 2)
  finalWeight      Decimal       @default(50) @db.Decimal(5, 2)
  passScore        Decimal       @default(4) @db.Decimal(4, 2)
  status           SubjectStatus @default(DRAFT)
  departmentId     Int
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  department      Department              @relation(fields: [departmentId], references: [id])
  prerequisites   SubjectPrerequisite[]   @relation("SubjectPrerequisites")
  prerequisiteFor SubjectPrerequisite[]   @relation("PrerequisiteFor")
  proposals       SubjectProposal[]
  classProposals  ClassProposal[]
  classes         Class[]
  restoreRequests SubjectRestoreRequest[]

  @@index([departmentId])
  @@index([status])
}

model SubjectRestoreRequest {
  id              Int                         @id @default(autoincrement())
  publicId        String                      @unique @default(uuid())
  subjectId       Int
  requestedById   Int
  reviewedById    Int?
  status          SubjectRestoreRequestStatus @default(PENDING)
  reason          String?                     @db.Text
  rejectionReason String?                     @db.Text
  reviewedAt      DateTime?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  subject     Subject @relation(fields: [subjectId], references: [id])
  requestedBy User    @relation("SubjectRestoreRequester", fields: [requestedById], references: [id])
  reviewedBy  User?   @relation("SubjectRestoreReviewer", fields: [reviewedById], references: [id])

  @@index([status, createdAt])
  @@index([subjectId, status])
}

model SubjectPrerequisite {
  subjectId      Int
  prerequisiteId Int
  subject        Subject @relation("SubjectPrerequisites", fields: [subjectId], references: [id], onDelete: Cascade)
  prerequisite   Subject @relation("PrerequisiteFor", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@id([subjectId, prerequisiteId])
  @@index([prerequisiteId])
}

model SubjectProposal {
  id                    Int            @id @default(autoincrement())
  publicId              String         @unique @default(uuid())
  code                  String
  name                  String
  description           String?        @db.Text
  credits               Int
  assignmentWeight      Decimal        @db.Decimal(5, 2)
  quizWeight            Decimal        @db.Decimal(5, 2)
  midtermWeight         Decimal        @db.Decimal(5, 2)
  finalWeight           Decimal        @db.Decimal(5, 2)
  passScore             Decimal        @default(4) @db.Decimal(4, 2)
  status                ProposalStatus @default(DRAFT)
  rejectionReason       String?        @db.Text
  departmentId          Int
  proposedById          Int
  trainingReviewedById  Int?
  principalReviewedById Int?
  approvedSubjectId     Int?
  submittedAt           DateTime?
  trainingReviewedAt    DateTime?
  principalReviewedAt   DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  department          Department @relation(fields: [departmentId], references: [id])
  proposedBy          User       @relation("SubjectProposer", fields: [proposedById], references: [id])
  trainingReviewedBy  User?      @relation("TrainingSubjectReviewer", fields: [trainingReviewedById], references: [id])
  principalReviewedBy User?      @relation("PrincipalSubjectReviewer", fields: [principalReviewedById], references: [id])
  approvedSubject     Subject?   @relation(fields: [approvedSubjectId], references: [id])

  @@index([status, createdAt])
  @@index([departmentId])
}

model ClassProposal {
  id                  Int                 @id @default(autoincrement())
  publicId            String              @unique @default(uuid())
  subjectId           Int
  proposedById        Int
  requestedClassCount Int
  maxStudentsPerClass Int
  registrationStart   DateTime
  registrationEnd     DateTime
  note                String?             @db.Text
  status              ClassProposalStatus @default(PENDING)
  rejectionReason     String?             @db.Text
  reviewedById        Int?
  reviewedAt          DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  subject    Subject @relation(fields: [subjectId], references: [id])
  proposedBy User    @relation("ClassProposer", fields: [proposedById], references: [id])
  reviewedBy User?   @relation("ClassProposalReviewer", fields: [reviewedById], references: [id])
  classes    Class[]

  @@index([status, createdAt])
  @@index([subjectId, status])
}

model Class {
  id                Int         @id @default(autoincrement())
  publicId          String      @unique @default(uuid())
  code              String      @unique
  name              String
  subjectId         Int
  departmentId      Int
  managerId         Int
  lecturerId        Int?
  classProposalId   Int?
  maxStudents       Int
  registrationStart DateTime
  registrationEnd   DateTime
  status            ClassStatus @default(DRAFT)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  subject       Subject         @relation(fields: [subjectId], references: [id])
  department    Department      @relation(fields: [departmentId], references: [id])
  manager       User            @relation("ClassManager", fields: [managerId], references: [id])
  lecturer      User?           @relation("ClassLecturer", fields: [lecturerId], references: [id])
  classProposal ClassProposal?  @relation(fields: [classProposalId], references: [id])
  schedules     ClassSchedule[]
  enrollments   Enrollment[]
  sections      LessonSection[]
  assessments   Assessment[]

  @@index([subjectId])
  @@index([departmentId])
  @@index([managerId])
  @@index([lecturerId])
}

model LessonSection {
  id        Int      @id @default(autoincrement())
  publicId  String   @unique @default(uuid())
  classId   Int
  title     String
  sortOrder Int      @default(0)
  isPublished Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  lessons   Lesson[]

  @@index([classId, sortOrder])
}

model Lesson {
  id          Int              @id @default(autoincrement())
  publicId    String           @unique @default(uuid())
  sectionId   Int
  title       String
  type        LessonType       @default(TEXT)
  content     String?          @db.LongText
  resourceUrl String?          @db.VarChar(1000)
  mediaId     Int?
  sortOrder   Int              @default(0)
  isPublished Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  section     LessonSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  media       Media?           @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  assessments Assessment[]
  progress    LessonProgress[]

  @@index([sectionId, sortOrder])
  @@index([mediaId])
}

model Media {
  id           Int       @id @default(autoincrement())
  publicId     String    @unique @default(uuid())
  type         MediaType
  filename     String    @unique
  originalName String
  mimeType     String
  size         Int
  title        String?
  altText      String?
  caption      String?   @db.Text
  description  String?   @db.Text
  folder       String    @default("common")
  width        Int?
  height       Int?
  uploadedById Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  uploadedBy User?    @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  lessons    Lesson[]

  @@index([uploadedById, createdAt])
  @@index([type, createdAt])
  @@index([folder, createdAt])
}

model SystemSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       Json
  updatedById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation("SystemSettingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
}

model LessonProgress {
  lessonId    Int
  studentId   Int
  completedAt DateTime @default(now())
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([lessonId, studentId])
  @@index([studentId])
}

model Assessment {
  id              Int                  @id @default(autoincrement())
  publicId        String               @unique @default(uuid())
  classId         Int
  lessonId        Int?
  title           String
  description     String?              @db.Text
  category        AssessmentCategory
  openAt          DateTime
  closeAt         DateTime
  durationMinutes Int?
  maxAttempts     Int                  @default(1)
  scorePolicy     ScorePolicy          @default(HIGHEST)
  maxViolations   Int                  @default(3)
  isPublished     Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  class           Class                @relation(fields: [classId], references: [id], onDelete: Cascade)
  lesson          Lesson?              @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  questions       AssessmentQuestion[]
  attempts        AssessmentAttempt[]

  @@index([classId, category])
}

model AssessmentQuestion {
  id              Int              @id @default(autoincrement())
  publicId        String           @unique @default(uuid())
  assessmentId    Int
  type            QuestionType
  content         String           @db.LongText
  points          Decimal          @db.Decimal(5, 2)
  sortOrder       Int              @default(0)
  judgeLanguageId Int?
  starterCode     String?          @db.LongText
  assessment      Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  options         QuestionOption[]
  testCases       CodeTestCase[]
  answers         AttemptAnswer[]

  @@index([assessmentId, sortOrder])
}

model QuestionOption {
  id         Int                   @id @default(autoincrement())
  publicId   String                @unique @default(uuid())
  questionId Int
  content    String                @db.Text
  isCorrect  Boolean               @default(false)
  sortOrder  Int                   @default(0)
  question   AssessmentQuestion    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedBy AttemptAnswerOption[]

  @@index([questionId, sortOrder])
}

model CodeTestCase {
  id             Int                @id @default(autoincrement())
  questionId     Int
  input          String?            @db.LongText
  expectedOutput String             @db.LongText
  isHidden       Boolean            @default(true)
  sortOrder      Int                @default(0)
  question       AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, sortOrder])
}

model AssessmentAttempt {
  id             Int                @id @default(autoincrement())
  publicId       String             @unique @default(uuid())
  assessmentId   Int
  studentId      Int
  attemptNumber  Int
  status         AttemptStatus      @default(IN_PROGRESS)
  score          Decimal?           @db.Decimal(6, 2)
  violationCount Int                @default(0)
  startedAt      DateTime           @default(now())
  deadlineAt     DateTime
  submittedAt    DateTime?
  gradedAt       DateTime?
  assessment     Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student        User               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers        AttemptAnswer[]
  violations     AttemptViolation[]

  @@unique([assessmentId, studentId, attemptNumber])
  @@index([studentId, status])
}

model AttemptAnswer {
  id              Int                   @id @default(autoincrement())
  attemptId       Int
  questionId      Int
  textAnswer      String?               @db.LongText
  sourceCode      String?               @db.LongText
  languageId      Int?
  awardedPoints   Decimal?              @db.Decimal(5, 2)
  feedback        String?               @db.Text
  judgeStatus     JudgeStatus           @default(NOT_REQUIRED)
  judgeMessage    String?               @db.Text
  gradedById      Int?
  gradedAt        DateTime?
  attempt         AssessmentAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question        AssessmentQuestion    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  gradedBy        User?                 @relation("AnswerGrader", fields: [gradedById], references: [id], onDelete: SetNull)
  selectedOptions AttemptAnswerOption[]

  @@unique([attemptId, questionId])
  @@index([questionId])
}

model AttemptAnswerOption {
  answerId Int
  optionId Int
  answer   AttemptAnswer  @relation(fields: [answerId], references: [id], onDelete: Cascade)
  option   QuestionOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([answerId, optionId])
  @@index([optionId])
}

model AttemptViolation {
  id        Int               @id @default(autoincrement())
  attemptId Int
  type      ViolationType
  createdAt DateTime          @default(now())
  attempt   AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId, createdAt])
}

model Enrollment {
  id         Int              @id @default(autoincrement())
  publicId   String           @unique @default(uuid())
  classId    Int
  studentId  Int
  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now())
  droppedAt  DateTime?
  finalScore Decimal?         @db.Decimal(4, 2)
  passed     Boolean?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  @@index([studentId, status])
  @@index([classId, status])
}

model Notification {
  id             BigInt    @id @default(autoincrement())
  publicId       String    @unique @default(uuid())
  recipientId    Int
  announcementId Int?
  type           String
  title          String
  message        String    @db.Text
  data           Json?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  recipient    User          @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  announcement Announcement? @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([recipientId, announcementId])
  @@index([recipientId, readAt, createdAt])
  @@index([announcementId])
}

model Announcement {
  id                  Int                  @id @default(autoincrement())
  publicId            String               @unique @default(uuid())
  title               String
  message             String               @db.Text
  category            AnnouncementCategory @default(GENERAL)
  audience            AnnouncementAudience @default(ALL)
  targetRoles         Json?
  targetDepartmentIds Json?
  status              AnnouncementStatus   @default(DRAFT)
  isPinned            Boolean              @default(false)
  scheduledAt         DateTime?
  publishedAt         DateTime?
  expiresAt           DateTime?
  cancelledAt         DateTime?
  createdById         Int
  publishedById       Int?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  createdBy     User           @relation("AnnouncementCreator", fields: [createdById], references: [id])
  publishedBy   User?          @relation("AnnouncementPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([status, scheduledAt])
  @@index([status, publishedAt, expiresAt])
  @@index([createdById])
  @@index([publishedById])
}

model ClassSchedule {
  id        Int     @id @default(autoincrement())
  classId   Int
  weekDay   WeekDay
  startTime String  @db.VarChar(5)
  endTime   String  @db.VarChar(5)
  room      String?
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, weekDay, startTime])
  @@index([classId])
}

model Session {
  id           Int      @id @default(autoincrement())
  userId       Int
  refreshToken String   @db.VarChar(255)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id             BigInt      @id @default(autoincrement())
  actorId        Int?
  actor          User?       @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action         AuditAction
  module         String
  targetType     String
  targetPublicId String?
  oldValue       Json?
  newValue       Json?
  ipAddress      String?
  userAgent      String?     @db.VarChar(500)
  createdAt      DateTime    @default(now())

  @@index([actorId, createdAt])
  @@index([module, createdAt])
  @@index([targetType, targetPublicId])
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
  LOCKED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum CourseStatus {
  DRAFT

  PENDING_PDT
  PDT_APPROVED
  PDT_REJECTED

  PENDING_PRINCIPAL
  PRINCIPAL_APPROVED
  PRINCIPAL_REJECTED

  ACTIVE
  INACTIVE
}

enum ApprovalAction {
  APPROVED
  REJECTED
}

enum ApprovalLevel {
  PDT
  PRINCIPAL
}

enum ClassStatus {
  DRAFT
  OPEN_REGISTRATION
  CLOSED_REGISTRATION
  IN_PROGRESS
  COMPLETED
  CANCELLED
  FULL
}

enum EnrollmentStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  DROPPED
}

enum LessonType {
  TEXT
  VIDEO
  DOCUMENT
  FILE
  LINK
  CODE
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum ExamQuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  ESSAY
  CODE
}

enum ExamAttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

enum GradeStatus {
  PASS
  FAIL
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  ASSIGN
  ENROLL
  DROP
  SUBMIT
  GRADE
  STATUS_CHANGE
  USER_DEACTIVATED
  USER_REACTIVATED
  PERMISSION_CHANGE
}

model User {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())

  code     String @unique
  fullName String

  email    String  @unique
  phone    String? @unique
  password String

  roleId Int?
  role   Role?      @relation(fields: [roleId], references: [id])
  status UserStatus @default(ACTIVE)

  gender    Gender?
  avatarUrl String?

  dateOfBirth DateTime?
  address     String?

  resetPasswordOtp          String?
  resetPasswordOtpExpiresAt DateTime?
  activationToken           String?   @unique
  activationTokenExpiresAt  DateTime?

  sessions Session[]

  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])

  lastLoginAt DateTime?
  deletedAt   DateTime?

  proposedCourses    Course[]         @relation("ProposedCourses")
  managedCourses     Course[]         @relation("ManagedCourses")
  assignedCourses    CourseLecturer[] @relation("AssignedCourses")
  teachingClasses    Class[]          @relation("TeachingClasses")
  assistingClasses   Class[]          @relation("AssistingClasses")
  managedClasses     Class[]          @relation("ManagedClasses")
  studentEnrollments Enrollment[]     @relation("StudentEnrollments")
  lessonProgresses   LessonProgress[] @relation("StudentLessonProgresses")
  examAttempts       ExamAttempt[]    @relation("StudentExamAttempts")
  codeSubmissions    CodeSubmission[] @relation("StudentCodeSubmissions")
  grades             Grade[]          @relation("StudentGrades")
  notifications      Notification[]   @relation("UserNotifications")
  sentNotifications  Notification[]   @relation("NotificationActors")
  courseApprovals    CourseApproval[] @relation("CourseApprovals")
  auditLogs          AuditLog[]       @relation("AuditLogs")
  uploadedMedia      Media[]          @relation("UploadedMedia")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@index([status])
  @@index([departmentId])
  @@index([activationToken])
}

model Role {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())

  code        String  @unique
  name        String
  description String? @db.Text
  isSystem    Boolean @default(false)

  users       User[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
}

model Permission {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())

  code        String  @unique
  name        String
  module      String
  description String? @db.Text

  roles RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([module])
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Session {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshToken String   @db.Text
  expiresAt    DateTime

  createdAt DateTime @default(now())

  @@index([userId])
}

model Department {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())

  name String @unique
  code String @unique

  users User[]

  courses Course[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())

  code String @unique
  name String

  description         String? @db.Text
  credits             Int
  requestedClassCount Int?

  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])

  departmentHeadId Int?
  departmentHead   User? @relation("ManagedCourses", fields: [departmentHeadId], references: [id])

  status                    CourseStatus @default(DRAFT)
  requiresPrincipalApproval Boolean      @default(true)

  proposedById Int
  proposedBy   User @relation("ProposedCourses", fields: [proposedById], references: [id])

  approvals CourseApproval[]
  lecturers CourseLecturer[]
  classes   Class[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([departmentHeadId])
  @@index([proposedById])
  @@index([status])
}

model CourseLecturer {
  courseId   Int
  lecturerId Int

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lecturer User   @relation("AssignedCourses", fields: [lecturerId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([courseId, lecturerId])
  @@index([lecturerId])
}

model AuditLog {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())

  actorId Int?
  actor   User? @relation("AuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  action AuditAction
  module String

  targetType     String?
  targetId       Int?
  targetPublicId String?

  oldValue Json?
  newValue Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([module])
  @@index([targetType, targetId])
  @@index([targetPublicId])
}

model CourseApproval {
  id Int @id @default(autoincrement())

  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  approverId Int
  approver   User @relation("CourseApprovals", fields: [approverId], references: [id])

  level  ApprovalLevel
  action ApprovalAction

  note String? @db.Text

  createdAt DateTime @default(now())

  @@index([courseId])
  @@index([approverId])
}

model Class {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())

  code        String  @unique
  name        String
  description String? @db.Text

  courseId Int
  course   Course @relation(fields: [courseId], references: [id])

  lecturerId Int?
  lecturer   User? @relation("TeachingClasses", fields: [lecturerId], references: [id])

  assistantId Int?
  assistant   User? @relation("AssistingClasses", fields: [assistantId], references: [id])

  departmentHeadId Int
  departmentHead   User @relation("ManagedClasses", fields: [departmentHeadId], references: [id])

  semester      String?
  academicYear  String?
  maxStudents   Int
  minStudents   Int?
  allowWaitlist Boolean @default(false)

  startDate      DateTime
  endDate        DateTime
  weeklySchedule Json?
  studyShift     String?
  room           String?
  onlineUrl      String?

  registrationStartDate DateTime?
  registrationEndDate   DateTime?
  registrationOpenedAt  DateTime?
  registrationClosedAt  DateTime?
  allowStudentDrop      Boolean   @default(true)
  checkScheduleConflict Boolean   @default(false)
  autoCloseWhenFull     Boolean   @default(true)

  status ClassStatus @default(DRAFT)

  enrollments    Enrollment[]
  lessonSections LessonSection[]
  lessons        Lesson[]
  exams          Exam[]
  grades         Grade[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@index([lecturerId])
  @@index([assistantId])
  @@index([departmentHeadId])
  @@index([status])
  @@index([semester])
  @@index([academicYear])
}

model Enrollment {
  id Int @id @default(autoincrement())

  studentId Int
  student   User @relation("StudentEnrollments", fields: [studentId], references: [id])

  classId Int
  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  status EnrollmentStatus @default(APPROVED)

  enrolledAt DateTime @default(now())

  @@unique([studentId, classId])
  @@index([studentId])
  @@index([classId])
  @@index([status])
}

model LessonSection {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())

  classId Int
  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  title       String
  description String? @db.Text
  sortOrder   Int
  isPublished Boolean @default(false)

  lessons Lesson[]
  exams   Exam[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, sortOrder])
  @@index([classId])
  @@index([isPublished])
}

model Lesson {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())

  classId Int
  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  sectionId Int?
  section   LessonSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  title           String
  description     String?    @db.Text
  type            LessonType @default(TEXT)
  content         String?    @db.Text
  resourceUrl     String?
  codeConfig      Json?
  durationMinutes Int?
  sortOrder       Int
  isPublished     Boolean    @default(false)

  progress        LessonProgress[]
  exams           Exam[]
  codeSubmissions CodeSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sectionId, sortOrder])
  @@index([classId])
  @@index([sectionId])
  @@index([isPublished])
}

model CodeSubmission {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())

  lessonId Int
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  studentId Int
  student   User @relation("StudentCodeSubmissions", fields: [studentId], references: [id], onDelete: Cascade)

  files       Json
  results     Json?
  passed      Boolean  @default(false)
  score       Float?
  submittedAt DateTime @default(now())

  @@index([lessonId])
  @@index([studentId])
  @@index([passed])
  @@index([submittedAt])
}

model Exam {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())

  classId Int
  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  sectionId Int?
  section   LessonSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  lessonId Int?
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  title       String
  description String? @db.Text

  durationMinutes Int?
  maxAttempts     Int     @default(1)
  passScore       Float   @default(5)
  isPublished     Boolean @default(false)

  questions ExamQuestion[]
  attempts  ExamAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classId])
  @@index([sectionId])
  @@index([lessonId])
  @@index([isPublished])
}

model ExamQuestion {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())

  examId Int
  exam   Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  type      ExamQuestionType @default(SINGLE_CHOICE)
  content   String           @db.Text
  points    Float            @default(1)
  sortOrder Int

  options ExamOption[]
  answers ExamAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examId, sortOrder])
  @@index([examId])
}

model ExamOption {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())

  questionId Int
  question   ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  content   String  @db.Text
  isCorrect Boolean @default(false)
  sortOrder Int

  answers ExamAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([questionId, sortOrder])
  @@index([questionId])
}

model ExamAttempt {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())

  examId Int
  exam   Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  studentId Int
  student   User @relation("StudentExamAttempts", fields: [studentId], references: [id], onDelete: Cascade)

  status         ExamAttemptStatus @default(IN_PROGRESS)
  score          Float?
  focusLostCount Int               @default(0)
  violationCount Int               @default(0)
  startedAt      DateTime          @default(now())
  submittedAt    DateTime?

  answers ExamAnswer[]

  @@index([examId])
  @@index([studentId])
  @@index([status])
}

model ExamAnswer {
  id Int @id @default(autoincrement())

  attemptId Int
  attempt   ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  questionId Int
  question   ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  optionId Int
  option   ExamOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId, optionId])
  @@index([attemptId])
  @@index([questionId])
  @@index([optionId])
}

model Grade {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())

  classId Int
  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  studentId Int
  student   User @relation("StudentGrades", fields: [studentId], references: [id], onDelete: Cascade)

  finalScore Float
  passScore  Float       @default(5)
  status     GradeStatus

  calculatedAt DateTime @default(now())

  @@unique([classId, studentId])
  @@index([classId])
  @@index([studentId])
  @@index([status])
}

model LessonProgress {
  id Int @id @default(autoincrement())

  lessonId Int
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  studentId Int
  student   User @relation("StudentLessonProgresses", fields: [studentId], references: [id], onDelete: Cascade)

  completedAt  DateTime?
  lastViewedAt DateTime  @default(now())

  @@unique([lessonId, studentId])
  @@index([studentId])
  @@index([lessonId])
}

model Media {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())

  fileName     String
  originalName String

  mimeType String
  size     Int

  url  String    @db.VarChar(2048)
  type MediaType @default(IMAGE)

  alt    String?
  folder String?

  uploadedById Int?
  uploadedBy   User? @relation("UploadedMedia", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([uploadedById])
  @@index([type])
  @@index([folder])
}

model Notification {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())

  recipientId Int
  recipient   User @relation("UserNotifications", fields: [recipientId], references: [id], onDelete: Cascade)

  actorId Int?
  actor   User? @relation("NotificationActors", fields: [actorId], references: [id], onDelete: SetNull)

  type    String
  title   String
  message String @db.Text
  data    Json?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([recipientId])
  @@index([actorId])
  @@index([type])
  @@index([readAt])
  @@index([createdAt])
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
  LOCKED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum CourseStatus {
  DRAFT

  PENDING_PDT
  PDT_APPROVED
  PDT_REJECTED

  PENDING_PRINCIPAL
  PRINCIPAL_APPROVED
  PRINCIPAL_REJECTED

  ACTIVE
  INACTIVE
}

enum ApprovalAction {
  APPROVED
  REJECTED
}

enum ApprovalLevel {
  PDT
  PRINCIPAL
}

enum ClassStatus {
  DRAFT
  OPEN_REGISTRATION
  CLOSED_REGISTRATION
  IN_PROGRESS
  COMPLETED
  CANCELLED
  FULL
}

enum EnrollmentStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  DROPPED
}

enum LessonStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  ARCHIVED
}

enum LessonContentType {
  TEXT
  VIDEO
  FILE
  IMAGE
  LINK
  CODE
  ASSIGNMENT
  EXAM
}

enum LessonProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  ASSIGN
  ENROLL
  DROP
  SUBMIT
  GRADE
  STATUS_CHANGE
  USER_DEACTIVATED
  USER_REACTIVATED
  PERMISSION_CHANGE
}

model User {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())

  code     String @unique
  fullName String

  email    String  @unique
  phone    String? @unique
  password String

  roleId Int?
  role   Role?      @relation(fields: [roleId], references: [id])
  status UserStatus @default(ACTIVE)

  gender    Gender?
  avatarUrl String?

  dateOfBirth DateTime?
  address     String?

  resetPasswordOtp          String?
  resetPasswordOtpExpiresAt DateTime?

  sessions Session[]

  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])

  lastLoginAt DateTime?
  deletedAt   DateTime?

  proposedCourses    Course[]         @relation("ProposedCourses")
  managedCourses     Course[]         @relation("ManagedCourses")
  assignedCourses    CourseLecturer[] @relation("AssignedCourses")
  teachingClasses    Class[]          @relation("TeachingClasses")
  assistingClasses   Class[]          @relation("AssistingClasses")
  managedClasses     Class[]          @relation("ManagedClasses")
  studentEnrollments Enrollment[]     @relation("StudentEnrollments")
  createdLessons     Lesson[]         @relation("CreatedLessons")
  publishedLessons   Lesson[]         @relation("PublishedLessons")
  hiddenLessons      Lesson[]         @relation("HiddenLessons")
  lessonProgresses   LessonProgress[] @relation("LessonProgressStudent")
  courseApprovals    CourseApproval[] @relation("CourseApprovals")
  auditLogs          AuditLog[]       @relation("AuditLogs")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@index([status])
  @@index([departmentId])
}

model Role {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())

  code        String  @unique
  name        String
  description String? @db.Text
  isSystem    Boolean @default(false)

  users       User[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
}

model Permission {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())

  code        String  @unique
  name        String
  module      String
  description String? @db.Text

  roles RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([module])
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Session {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshToken String   @db.Text
  expiresAt    DateTime

  createdAt DateTime @default(now())

  @@index([userId])
}

model Department {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())

  name String @unique
  code String @unique

  users User[]

  courses Course[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())

  code String @unique
  name String

  description String? @db.Text
  credits     Int
  requestedClassCount Int?

  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])

  departmentHeadId Int?
  departmentHead   User? @relation("ManagedCourses", fields: [departmentHeadId], references: [id])

  status CourseStatus @default(DRAFT)
  requiresPrincipalApproval Boolean @default(true)

  proposedById Int
  proposedBy   User @relation("ProposedCourses", fields: [proposedById], references: [id])

  approvals CourseApproval[]
  lecturers CourseLecturer[]
  classes   Class[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([departmentHeadId])
  @@index([proposedById])
  @@index([status])
}

model CourseLecturer {
  courseId   Int
  lecturerId Int

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lecturer User   @relation("AssignedCourses", fields: [lecturerId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([courseId, lecturerId])
  @@index([lecturerId])
}

model AuditLog {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())

  actorId Int?
  actor   User? @relation("AuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  action AuditAction
  module String

  targetType     String?
  targetId       Int?
  targetPublicId String?

  oldValue Json?
  newValue Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([module])
  @@index([targetType, targetId])
  @@index([targetPublicId])
}

model CourseApproval {
  id Int @id @default(autoincrement())

  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  approverId Int
  approver   User @relation("CourseApprovals", fields: [approverId], references: [id])

  level  ApprovalLevel
  action ApprovalAction

  note String? @db.Text

  createdAt DateTime @default(now())

  @@index([courseId])
  @@index([approverId])
}

model Class {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())

  code String @unique
  name String
  description String? @db.Text

  courseId Int
  course   Course @relation(fields: [courseId], references: [id])

  lecturerId Int?
  lecturer   User? @relation("TeachingClasses", fields: [lecturerId], references: [id])

  assistantId Int?
  assistant   User? @relation("AssistingClasses", fields: [assistantId], references: [id])

  departmentHeadId Int
  departmentHead   User @relation("ManagedClasses", fields: [departmentHeadId], references: [id])

  semester String?
  academicYear String?
  maxStudents Int
  minStudents Int?
  allowWaitlist Boolean @default(false)

  startDate DateTime
  endDate   DateTime
  weeklySchedule Json?
  studyShift String?
  room String?
  onlineUrl String?

  registrationStartDate DateTime?
  registrationEndDate DateTime?
  registrationOpenedAt DateTime?
  registrationClosedAt DateTime?
  allowStudentDrop Boolean @default(true)
  checkScheduleConflict Boolean @default(false)
  autoCloseWhenFull Boolean @default(true)

  status ClassStatus @default(DRAFT)

  enrollments Enrollment[]
  lessons     Lesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@index([lecturerId])
  @@index([assistantId])
  @@index([departmentHeadId])
  @@index([status])
  @@index([semester])
  @@index([academicYear])
}

model Enrollment {
  id Int @id @default(autoincrement())

  studentId Int
  student   User @relation("StudentEnrollments", fields: [studentId], references: [id])

  classId Int
  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  status EnrollmentStatus @default(APPROVED)

  enrolledAt DateTime @default(now())

  @@unique([studentId, classId])
  @@index([studentId])
  @@index([classId])
  @@index([status])
}

model Lesson {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())

  classId Int
  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  title       String
  description String? @db.Text
  chapter     String?
  orderIndex  Int
  durationMinutes Int?

  status LessonStatus @default(DRAFT)
  primaryContentType LessonContentType @default(TEXT)

  allowStudentView Boolean @default(true)
  allowDownload Boolean @default(true)
  requirePreviousCompletion Boolean @default(false)
  availableFrom DateTime?
  availableUntil DateTime?
  trackProgress Boolean @default(true)

  hasVideo Boolean @default(false)
  hasAttachment Boolean @default(false)
  hasLinkedExam Boolean @default(false)

  publishedAt DateTime?
  publishedById Int?
  publishedBy   User? @relation("PublishedLessons", fields: [publishedById], references: [id])

  hiddenAt DateTime?
  hiddenById Int?
  hiddenBy   User? @relation("HiddenLessons", fields: [hiddenById], references: [id])
  hiddenReason String? @db.Text

  createdById Int
  createdBy   User @relation("CreatedLessons", fields: [createdById], references: [id])

  blocks      LessonContentBlock[]
  attachments LessonAttachment[]
  progresses  LessonProgress[]

  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, orderIndex])
  @@index([classId])
  @@index([createdById])
  @@index([publishedById])
  @@index([hiddenById])
  @@index([status])
  @@index([primaryContentType])
  @@index([deletedAt])
}

model LessonContentBlock {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())

  lessonId Int
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  type LessonContentType
  title String?
  content String? @db.Text
  fileUrl String?
  fileName String?
  fileSize Int?
  mimeType String?
  orderIndex Int
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lessonId])
  @@index([type])
}

model LessonAttachment {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())

  lessonId Int
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  fileName String
  fileUrl String
  fileSize Int?
  mimeType String?
  uploadedById Int?
  uploadedAt DateTime @default(now())

  @@index([lessonId])
  @@index([uploadedById])
}

model LessonProgress {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())

  lessonId Int
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  studentId Int
  student   User @relation("LessonProgressStudent", fields: [studentId], references: [id])

  status LessonProgressStatus @default(NOT_STARTED)
  progressPercent Int @default(0)
  lastViewedAt DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lessonId, studentId])
  @@index([lessonId])
  @@index([studentId])
  @@index([status])
}
